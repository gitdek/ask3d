{
  "version": 1,
  "state": [
    {"id": "cancelled", "when": {"all": [{"eq": [{"var": "status"}, "\"idle\""]}, {"not": {"eq": [{"var": "cancelAt"}, "0"]}}]}, "label": "Cancelled; idle"},
    {"id": "idle", "when": {"eq": [{"var": "status"}, "\"idle\""]}, "label": "Idle"},
    {"id": "compiling", "when": {"eq": [{"var": "status"}, "\"compiling\""]}, "label": "Compiling; worker and timer active"},
    {"id": "done", "when": {"eq": [{"var": "status"}, "\"done\""]}, "label": "Done; worker and timer cleared"},
    {"id": "error", "when": {"eq": [{"var": "status"}, "\"error\""]}, "label": "Error; worker and timer cleared"},
    {"id": "timeout", "when": true, "label": "Timeout; worker and timer cleared"}
  ],
  "step": [
    {"id": "start", "when": {"eq": [{"action": true}, "Compile"]}, "label": "Start or replace compile"},
    {"id": "cancel", "when": {"eq": [{"action": true}, "Cancel"]}, "label": "Cancel and invalidate job"},
    {"id": "finish", "when": {"eq": [{"action": true}, "Finish"]}, "label": "Apply current outcome; teardown"},
    {"id": "stale-worker", "when": {"eq": [{"action": true}, "IgnoreStaleWorker"]}, "label": "Ignore stale worker callback"},
    {"id": "stale-timeout", "when": {"eq": [{"action": true}, "IgnoreStaleTimeout"]}, "label": "Ignore stale timeout"},
    {"id": "wait", "when": true, "label": "Wait or ignore mismatched message"}
  ]
}
