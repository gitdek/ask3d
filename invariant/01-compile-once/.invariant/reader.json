    "report": {
      "rules": [
        {
          "name": "Spec",
          "kind": "spec",
          "says": "The compile starts in Init, and every step is a Next step.",
          "sha256": "sha256:c06177101f662e93802a310062cf77a0dbab60efb85ad9dc2904441e5878ed84"
        },
        {
          "name": "SingleSettlement",
          "kind": "invariant",
          "says": "The promise has no settlements while pending and exactly one once it resolves or rejects.",
          "sha256": "sha256:37678ddd02e2995cdfc604a88ddb30a109d99c879989e60347cfdfdf9d13bac0"
        },
        {
          "name": "FirstSignalWins",
          "kind": "invariant",
          "says": "The first delivered signal determines whether the promise resolves with its model or rejects with its prescribed error, and later signals preserve that outcome.",
          "sha256": "sha256:79f5a43f38737d002a60d4deec8e2fc61c0881eaaef79c8164cd0ced54b30404"
        },
        {
          "name": "WorkerTerminatedAfterSettlement",
          "kind": "invariant",
          "says": "Whenever the promise has settled, its worker has been terminated.",
          "sha256": "sha256:67518b1a665cbcbf98df8d98bfc535e9ebd1a28ed78c1a698353623679de6f16"
        },
        {
          "name": "TimerInactiveAfterSettlement",
          "kind": "invariant",
          "says": "Whenever the promise has settled, its timer is inactive because it was cleared or its one-shot timeout expired.",
          "sha256": "sha256:3f925bb894ff6209ae67ecce6563ebaaaba1a3069a1cd29db16a4f449fab4391"
        },
        {
          "name": "TypeOK",
          "kind": "invariant",
          "says": "Every recorded event, promise outcome, counter and resource flag has its declared type.",
          "sha256": "sha256:1612690b22da1950229d79c0a5d2f392ada93d996c65b721745252af6b43d6ec"
        },
        {
          "name": "DoneWins",
