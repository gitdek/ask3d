{
  "version": 1,
  "state": [
    {
      "id": "pending",
      "when": {"eq": [{"var": "outcome"}, "\"pending\""]},
      "label": "Compile pending; worker running and timer active"
    },
    {
      "id": "resolved",
      "when": {"eq": [{"var": "outcome"}, "\"resolved\""]},
      "label": "Resolved with the first model; worker terminated and timer inactive"
    },
    {
      "id": "timeout",
      "when": {"eq": [{"var": "value"}, "\"color part render timed out\""]},
      "label": "Rejected by timeout; worker terminated and timer expired"
    },
    {
      "id": "failure",
      "when": {"eq": [{"var": "value"}, "\"color part failed to compile\""]},
      "label": "Rejected by failure response; worker terminated and timer inactive"
    },
    {
      "id": "error",
      "when": true,
      "label": "Rejected by worker error; worker terminated and timer inactive"
    }
  ],
  "step": [
    {
      "id": "done",
      "when": {"all": [
        {"eq": [{"from": "outcome"}, "\"pending\""]},
        {"eq": [{"to": "outcome"}, "\"resolved\""]}
      ]},
      "label": "Done response resolves with its model and cleans up"
    },
    {
      "id": "timeout",
      "when": {"all": [
        {"eq": [{"from": "outcome"}, "\"pending\""]},
        {"eq": [{"to": "value"}, "\"color part render timed out\""]}
      ]},
      "label": "One-shot timer expires, terminates worker and rejects"
    },
    {
      "id": "failure",
      "when": {"all": [
        {"eq": [{"from": "outcome"}, "\"pending\""]},
        {"eq": [{"to": "value"}, "\"color part failed to compile\""]}
      ]},
      "label": "Non-done response rejects and cleans up"
    },
    {
      "id": "error",
      "when": {"all": [
        {"eq": [{"from": "outcome"}, "\"pending\""]},
        {"eq": [{"to": "outcome"}, "\"rejected\""]}
      ]},
      "label": "Worker error rejects with its message or fallback and cleans up"
    },
    {
      "id": "late",
      "when": {"not": {"eq": [{"from": "deliveries"}, {"to": "deliveries"}]}},
      "label": "Late worker callback repeats cleanup and preserves the first outcome"
    },
    {
      "id": "unchanged",
      "when": true,
      "label": "Outcome remains unchanged"
    }
  ]
}
