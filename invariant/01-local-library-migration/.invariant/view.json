{
  "version": 1,
  "state": [
    {
      "id": "no-storage",
      "when": {
        "eq": [
          {
            "var": "storage"
          },
          "FALSE"
        ]
      },
      "label": "Local storage unavailable"
    },
    {
      "id": "completed",
      "when": {
        "all": [
          {
            "eq": [
              {
                "var": "phase"
              },
              "\"idle\""
            ]
          },
          {
            "eq": [
              {
                "var": "flag"
              },
              "TRUE"
            ]
          }
        ]
      },
      "label": "Migration marked complete"
    },
    {
      "id": "waiting",
      "when": {
        "eq": [
          {
            "var": "phase"
          },
          "\"idle\""
        ]
      },
      "label": "Ready for a browser load"
    },
    {
      "id": "reading",
      "when": {
        "eq": [
          {
            "var": "phase"
          },
          "\"read\""
        ]
      },
      "label": "Read local item bytes"
    },
    {
      "id": "uploading",
      "when": {
        "eq": [
          {
            "var": "phase"
          },
          "\"upload\""
        ]
      },
      "label": "Upload local item"
    },
    {
      "id": "deleting",
      "when": {
        "eq": [
          {
            "var": "phase"
          },
          "\"delete\""
        ]
      },
      "label": "Request old database deletion"
    },
    {
      "id": "all",
      "when": true,
      "label": "Check and migrate the local library"
    }
  ],
  "step": [
    {
      "id": "load",
      "when": {
        "eq": [
          {
            "action": true
          },
          "StartLoad"
        ]
      },
      "label": "Browser loads"
    },
    {
      "id": "read-failed",
      "when": {
        "eq": [
          {
            "action": true
          },
          "BytesUnavailable"
        ]
      },
      "label": "Local bytes unavailable"
    },
    {
      "id": "upload-failed",
      "when": {
        "eq": [
          {
            "action": true
          },
          "UploadFailure"
        ]
      },
      "label": "Upload fails"
    },
    {
      "id": "upload-succeeds",
      "when": {
        "eq": [
          {
            "action": true
          },
          "UploadSuccess"
        ]
      },
      "label": "Upload succeeds"
    },
    {
      "id": "skip-existing",
      "when": {
        "eq": [
          {
            "action": true
          },
          "SkipExisting"
        ]
      },
      "label": "Same kind and name already shared"
    },
    {
      "id": "mark",
      "when": {
        "eq": [
          {
            "action": true
          },
          "MarkerWritten"
        ]
      },
      "label": "Write completion flag"
    },
    {
      "id": "delete",
      "when": {
        "eq": [
          {
            "action": true
          },
          "DeleteDatabase"
        ]
      },
      "label": "Request database deletion"
    },
    {
      "id": "all",
      "when": true,
      "label": "Continue migration or return"
    }
  ]
}
