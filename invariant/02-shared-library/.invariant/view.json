{
  "version": 1,
  "state": [
    {"id": "finished", "when": {"eq": [{"var": "pc"}, "\"done\""]}, "label": "Bounded run finished"},
    {"id": "failed", "when": {"eq": [{"var": "pc"}, "\"error\""]}, "label": "File operation failed; index remains safe"},
    {"id": "succeeded", "when": {"eq": [{"var": "pc"}, "\"success\""]}, "label": "Request succeeded"},
    {"id": "waiting", "when": {"eq": [{"var": "pc"}, "\"idle\""]}, "label": "Requests waiting for index lock"},
    {"id": "reading", "when": {"eq": [{"var": "pc"}, "\"read\""]}, "label": "Writer owns lock and reads index"},
    {"id": "blob", "when": {"any": [{"eq": [{"var": "pc"}, "\"blob-mkdir\""]}, {"eq": [{"var": "pc"}, "\"blob-write\""]}]}, "label": "Preparing the new item bytes"},
    {"id": "index", "when": {"any": [{"eq": [{"var": "pc"}, "\"index-mkdir\""]}, {"eq": [{"var": "pc"}, "\"index-write\""]}, {"eq": [{"var": "pc"}, "\"index-rename\""]}]}, "label": "Preparing atomic index publication"},
    {"id": "cleanup", "when": {"eq": [{"var": "pc"}, "\"cleanup\""]}, "label": "Index published; reclaiming obsolete blobs"},
    {"id": "all", "when": true, "label": "Shared library"}
  ],
  "step": [
    {"id": "fail", "when": {"any": [{"eq": [{"action": true}, "FileOperationFailure"]}, {"eq": [{"action": true}, "ReadIndexFailure"]}]}, "label": "File operation rejects"},
    {"id": "success", "when": {"eq": [{"action": true}, "RespondSuccess"]}, "label": "Return success"},
    {"id": "acquire", "when": {"eq": [{"action": true}, "Acquire"]}, "label": "Acquire index lock"},
    {"id": "read", "when": {"eq": [{"action": true}, "ReadIndex"]}, "label": "Read existing index"},
    {"id": "mkdir", "when": {"eq": [{"action": true}, "MakeDirectory"]}, "label": "Ensure blob directory exists"},
    {"id": "blob", "when": {"eq": [{"action": true}, "WriteBlob"]}, "label": "Write supplied bytes"},
    {"id": "temporary", "when": {"eq": [{"action": true}, "WriteTemporaryIndex"]}, "label": "Write temporary index"},
    {"id": "publish", "when": {"eq": [{"action": true}, "PublishIndex"]}, "label": "Rename temporary index into place"},
    {"id": "remove", "when": {"eq": [{"action": true}, "RemoveObsoleteBlob"]}, "label": "Remove an unlisted blob"},
    {"id": "background", "when": {"eq": [{"action": true}, "RemoveBackgroundBlobs"]}, "label": "Remove unlisted background blobs"},
    {"id": "release", "when": {"eq": [{"action": true}, "Release"]}, "label": "Release index lock"},
    {"id": "observe", "when": {"eq": [{"action": true}, "Observe"]}, "label": "Read or retain current state"},
    {"id": "all", "when": true, "label": "Library operation"}
  ]
}
