{
  "version": 1,
  "state": [
    {"id": "starting", "when": {"eq": [{"var": "phase"}, "\"starting\""]}, "label": "Starting"},
    {"id": "generating", "when": {"eq": [{"var": "phase"}, "\"polling\""]}, "label": "Generating"},
    {"id": "delivering", "when": {"any": [{"eq": [{"var": "phase"}, "\"downloading\""]}, {"eq": [{"var": "phase"}, "\"delivering\""]}]}, "label": "Delivering"},
    {"id": "delivered", "when": {"any": [{"eq": [{"var": "outcome"}, "\"delivered\""]}, {"eq": [{"var": "outcome"}, "\"delivered-after-clear\""]}, {"eq": [{"var": "outcome"}, "\"delivered-after-rejection\""]}]}, "label": "Delivered"},
    {"id": "error", "when": {"not": {"eq": [{"var": "error"}, "\"\""]}}, "label": "Error"},
    {"id": "ready", "when": true, "label": "Ready"}
  ],
  "step": [
    {"id": "reload", "when": {"not": {"eq": [{"from": "mount"}, {"to": "mount"}]}}, "label": "Reload"},
    {"id": "clear", "when": {"not": {"eq": [{"from": "dismissed"}, {"to": "dismissed"}]}}, "label": "Clear"},
    {"id": "start", "when": {"all": [{"eq": [{"to": "phase"}, "\"starting\""]}, {"not": {"eq": [{"from": "phase"}, {"to": "phase"}]}}]}, "label": "Start"},
    {"id": "adopt", "when": {"all": [{"eq": [{"to": "phase"}, "\"polling\""]}, {"not": {"eq": [{"from": "phase"}, {"to": "phase"}]}}]}, "label": "Adopt task"},
    {"id": "download", "when": {"all": [{"eq": [{"to": "phase"}, "\"downloading\""]}, {"not": {"eq": [{"from": "phase"}, {"to": "phase"}]}}]}, "label": "Download statue"},
    {"id": "callback", "when": {"all": [{"eq": [{"to": "phase"}, "\"delivering\""]}, {"not": {"eq": [{"from": "phase"}, {"to": "phase"}]}}]}, "label": "Invoke delivery"},
    {"id": "complete", "when": {"not": {"eq": [{"from": "completed"}, {"to": "completed"}]}}, "label": "Complete delivery"},
    {"id": "failure", "when": {"all": [{"eq": [{"to": "phase"}, "\"idle\""]}, {"not": {"eq": [{"from": "phase"}, {"to": "phase"}]}}]}, "label": "Report error and release"},
    {"id": "poll", "when": {"not": {"eq": [{"from": "pollFailures"}, {"to": "pollFailures"}]}}, "label": "Poll response"},
    {"id": "sidecar", "when": {"not": {"eq": [{"from": "sidecar"}, {"to": "sidecar"}]}}, "label": "Sidecar update"},
    {"id": "recovery", "when": {"not": {"eq": [{"from": "recovery"}, {"to": "recovery"}]}}, "label": "Latest task response"},
    {"id": "wait", "when": true, "label": "Wait or refuse busy start"}
  ]
}
