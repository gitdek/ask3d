# Which LLM powers the chatbot. Valid providers: google | openrouter | anthropic
AI_PROVIDER=google
AI_MODEL=gemini-3.8-flash

# Google Gemini — free API key, no credit card: https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenRouter — free models, 50 req/day (1,000/day after a one-time $10 credit
# purchase): https://openrouter.ai   e.g. AI_PROVIDER=openrouter AI_MODEL=z-ai/glm-5.2:free
OPENROUTER_API_KEY=

# Anthropic Claude — https://console.anthropic.com
# e.g. AI_PROVIDER=anthropic AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
