{
  "version": 1,
  "parts": [
    {
      "name": "web",
      "directory": ".",
      "language": "typescript",
      "image": "node@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1",
      "lockfiles": [
        "package-lock.json"
      ],
      "inputs": [
        "eslint.config.mjs",
        "package.json",
        "tsconfig.json",
        "vitest.config.mjs"
      ],
      "commands": {
        "install": {
          "argv": [
            "npm",
            "ci",
            "--ignore-scripts",
            "--no-audit",
            "--no-fund"
          ]
        },
        "format": {
          "not_applicable": "ask3d has no formatter; ESLint checks style."
        },
        "lint": {
          "argv": [
            "eslint",
            "."
          ]
        },
        "build": {
          "argv": [
            "npm",
            "run",
            "typecheck"
          ]
        },
        "test": {
          "argv": [
            "vitest",
            "run"
          ]
        },
        "test_one": {
          "argv": [
            "vitest",
            "run",
            "--testNamePattern",
            "{test}"
          ]
        }
      }
    }
  ],
  "agent_rules": [
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "current_state": [
    "README.md"
  ],
  "trusted_paths": [
    "statue-service/"
  ],
  "shared_paths": []
}
